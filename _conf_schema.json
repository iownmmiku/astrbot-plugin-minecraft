{
  "server_mode": {
    "description": "服务器模式",
    "type": "string",
    "options": [
      "local",
      "remote",
      "launcher_api"
    ],
    "labels": [
      "本地服务器",
      "远程服务器",
      "启动器 API"
    ],
    "default": "local"
  },
  "enable_server": {
    "description": "允许插件启服",
    "hint": "关闭后插件不会启动、重启或停止本地服务器。",
    "type": "bool",
    "default": true
  },
  "auto_start_server": {
    "description": "自动启动本地服务器",
    "type": "bool",
    "default": true
  },
  "launcher_api_url": {
    "description": "启动器 API 地址",
    "type": "string",
    "default": "http://127.0.0.1:8765"
  },
  "bot_username": {
    "description": "机器人游戏内名字",
    "type": "string",
    "default": "AstrBot"
  },
  "driver": {
    "description": "机器人驱动方式",
    "type": "string",
    "options": [
      "protocol",
      "bridge"
    ],
    "labels": [
      "内置协议客户端",
      "指挥服务端 AI 女仆（mod）"
    ],
    "default": "protocol",
    "hint": "bridge = 连到服务端 astrbot-ai-maid mod 的桥（自带 AI 女仆：原版物理 / 背包 / 饱食度）。"
  },
  "bridge_host": {
    "description": "女仆桥地址",
    "type": "string",
    "default": "127.0.0.1"
  },
  "bridge_port": {
    "description": "女仆桥端口",
    "type": "int",
    "default": 8124
  },
  "remote_host": {
    "description": "远程服务器地址",
    "type": "string",
    "default": "127.0.0.1"
  },
  "remote_port": {
    "description": "远程服务器端口",
    "type": "int",
    "default": 25565
  },
  "local_version": {
    "description": "本地服务器版本",
    "type": "string",
    "default": "1.20.1"
  },
  "local_port": {
    "description": "本地服务器端口",
    "type": "int",
    "default": 25565
  },
  "local_motd": {
    "description": "本地服务器 MOTD",
    "type": "string",
    "default": "AstrBot Minecraft"
  },
  "java_path": {
    "description": "Java 路径（留空自动检测）",
    "type": "string",
    "default": ""
  },
  "local_world_import": {
    "description": "导入单人存档路径",
    "type": "string",
    "default": ""
  },
  "auto_connect": {
    "description": "插件加载后自动连接",
    "type": "bool",
    "default": true
  },
  "auto_reconnect": {
    "description": "断线自动重连",
    "type": "bool",
    "default": true
  },
  "max_reconnect_times": {
    "description": "最大重连次数",
    "type": "int",
    "default": 5
  },
  "persona_source": {
    "description": "人格来源",
    "type": "string",
    "options": [
      "custom",
      "persona",
      "default"
    ],
    "labels": [
      "AstrBot 当前人格",
      "AstrBot 指定人格",
      "插件自定义人格"
    ],
    "default": "default"
  },
  "astrbot_persona_id": {
    "description": "AstrBot 指定人格",
    "type": "string",
    "_special": "select_persona",
    "default": "",
    "hint": "填 AstrBot 人格的名字；仅人格来源为「AstrBot 指定人格」时生效。"
  },
  "model_source": {
    "description": "模型来源",
    "type": "string",
    "options": [
      "default",
      "custom"
    ],
    "labels": [
      "AstrBot 当前模型",
      "插件独立模型"
    ],
    "default": "default"
  },
  "llm_model": {
    "description": "插件独立模型 ID",
    "hint": "仅模型来源为插件独立模型时生效。",
    "type": "string",
    "default": ""
  },
  "auto_reply_in_game": {
    "description": "游戏内自动回复",
    "type": "bool",
    "default": true
  },
  "enable_autonomous_behaviors": {
    "description": "启用自主行为",
    "type": "bool",
    "default": true
  },
  "enable_goal_system": {
    "description": "启用目标系统",
    "type": "bool",
    "default": false
  },
  "goal_use_llm": {
    "description": "目标选择使用模型",
    "type": "bool",
    "default": true
  },
  "enable_action_queue": {
    "description": "启用动作队列",
    "type": "bool",
    "default": true
  },
  "enable_pathfinding": {
    "description": "启用智能寻路",
    "type": "bool",
    "default": true
  },
  "mine_distance": {
    "description": "挖掘最大距离",
    "type": "int",
    "default": 4
  },
  "auto_eat_threshold": {
    "description": "自动进食阈值",
    "type": "int",
    "default": 10
  },
  "auto_flee_enabled": {
    "description": "自动逃离实体",
    "type": "bool",
    "default": false
  },
  "pathfinding_max_cost": {
    "description": "寻路最大代价",
    "type": "int",
    "default": 1000
  },
  "persona_custom_desc": {
    "description": "插件自定义人格描述",
    "type": "text",
    "default": "",
    "hint": "仅人格来源为「插件自定义人格」时生效，也可以用 /mc人格 custom <描述> 设置。"
  },
  "mc_chat_wake_words": {
    "description": "游戏内唤醒词",
    "type": "list",
    "default": [],
    "hint": "留空则使用机器人名字；列表里任意一个词出现在聊天中就会触发回复。"
  },
  "in_game_reply_cooldown": {
    "description": "游戏内自动回复冷却（秒）",
    "type": "int",
    "default": 30,
    "hint": "同一玩家在冷却时间内只触发一次 LLM 回复，0 表示不限制。"
  },
  "manage_llm_tool_activation": {
    "description": "按进服状态自动启停 mc_* 工具",
    "type": "bool",
    "default": true,
    "hint": "开启后只有机器人进服时才会把这些工具暴露给模型，避免污染其它会话。"
  },
  "enable_idle_behaviors": {
    "description": "启用空闲小动作",
    "type": "bool",
    "default": true
  },
  "idle_broadcast_interval": {
    "description": "空闲自言自语间隔（秒）",
    "type": "int",
    "default": 180
  },
  "idle_llm_generation": {
    "description": "空闲台词使用模型生成",
    "type": "bool",
    "default": true
  },
  "idle_hungry_threshold": {
    "description": "饥饿抱怨阈值",
    "type": "int",
    "default": 6
  },
  "enable_mood": {
    "description": "启用心情系统",
    "type": "bool",
    "default": true
  }
}
